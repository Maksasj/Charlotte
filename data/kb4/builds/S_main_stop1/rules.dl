% learned rules: id, layer, status; compiled layer form
% learn/L1/1  layer 1  status hypothesis  conf 0.75  support 3  rule has_property(X, heat_resistant) :- made_of(X, metal)
lholds(X, has_property, heat_resistant) :- hh(X, made_of, metal), not holds(X, has_property, heat_resistant), not holdsn(X, has_property, heat_resistant).
% learn/L1/2  layer 1  status retracted  conf 0.75  support 3  rule made_of(X, metal) :- made_of(X, plastic)
