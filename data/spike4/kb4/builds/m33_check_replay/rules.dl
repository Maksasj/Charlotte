% learned rules: id, layer, status; compiled layer form
% learn/L1/1  layer 1  status hypothesis  conf 0.75  support 3  rule can_go_in(X, oven) :- has_property(X, heat_resistant)
lholds(X, can_go_in, oven) :- hh(X, has_property, heat_resistant), not holds(X, can_go_in, oven), not holdsn(X, can_go_in, oven).
% learn/L1/2  layer 1  status waiting  conf 0.75  support 3  rule made_of(X, glass) :- can_do(X, contain)
lholds(X, made_of, glass) :- hh(X, can_do, contain), not holds(X, made_of, glass), not holdsn(X, made_of, glass).
% learn/L1/3  layer 1  status waiting  conf 0.75  support 3  rule made_of(X, plastic) :- can_do(X, contain)
lholds(X, made_of, plastic) :- hh(X, can_do, contain), not holds(X, made_of, plastic), not holdsn(X, made_of, plastic).
% learn/L1/4  layer 1  status hypothesis  conf 0.80  support 4  rule made_of(X, metal) :- can_go_in(X, dishwasher)
lholds(X, made_of, metal) :- hh(X, can_go_in, dishwasher), not holds(X, made_of, metal), not holdsn(X, made_of, metal).
% learn/L1/5  layer 1  status hypothesis  conf 0.75  support 3  rule has_property(X, absorbent) :- can_do(X, wipe)
lholds(X, has_property, absorbent) :- hh(X, can_do, wipe), not holds(X, has_property, absorbent), not holdsn(X, has_property, absorbent).
% learn/L1/6  layer 1  status hypothesis  conf 0.75  support 3  rule not can_go_in(X, oven) :- made_of(X, plastic)
lholdsn(X, can_go_in, oven) :- hh(X, made_of, plastic), not holds(X, can_go_in, oven), not holdsn(X, can_go_in, oven).
% learn/L1/7  layer 1  status hypothesis  conf 0.75  support 3  rule not can_go_in(X, oven) :- can_do(X, contain), made_of(X, plastic)
lholdsn(X, can_go_in, oven) :- hh(X, can_do, contain), hh(X, made_of, plastic), not holds(X, can_go_in, oven), not holdsn(X, can_go_in, oven).
% learn/L2/8  layer 2  status hypothesis  conf 0.75  support 4  rule can_do(X, soak_up) :- has_property(X, absorbent)
lholds(X, can_do, soak_up) :- hh(X, has_property, absorbent), not holds(X, can_do, soak_up), not holdsn(X, can_do, soak_up).
% learn/L1/9  layer 1  status hypothesis  conf 0.75  support 3  rule can_do(X, cut) :- has_property(X, sharp)
lholds(X, can_do, cut) :- hh(X, has_property, sharp), not holds(X, can_do, cut), not holdsn(X, can_do, cut).
% learn/L1/10  layer 1  status hypothesis  conf 0.75  support 3  rule can_do(X, soak_up) :- can_do(X, wipe)
lholds(X, can_do, soak_up) :- hh(X, can_do, wipe), not holds(X, can_do, soak_up), not holdsn(X, can_do, soak_up).
% learn/L2/11  layer 2  status hypothesis  conf 0.75  support 3  rule made_of(X, rubber) :- not can_go_in(X, oven)
lholds(X, made_of, rubber) :- hhn(X, can_go_in, oven), not holds(X, made_of, rubber), not holdsn(X, made_of, rubber).
% learn/B/1  layer 1  status subsumed  conf 0.75  support 1  rule stand_in(X, -) :- 
lunfit(S, J) :- lacks(user, I), role(S, I, F), has(user, J), demands(S, F, P, Y), holdsn(J, P, Y).
% learn/B/2  layer 1  status subsumed  conf 0.75  support 1  rule stand_in(X, -) :- 
lopen(S, J) :- lacks(user, I), role(S, I, F), has(user, J), demands(S, F, P, Y), not holds(J, P, Y), not holdsn(J, P, Y).
% learn/B/3  layer 1  status subsumed  conf 0.75  support 1  rule stand_in(X, -) :- 
stand_in(S, I, J) :- lacks(user, I), has(user, J), role(S, I, F), can(J, F), J != I, not lunfit(S, J), not lopen(S, J).
