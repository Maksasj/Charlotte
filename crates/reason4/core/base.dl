% Design 4.0 base rules B1-B9 (section 4.3-4.4), written once as data. Sections start with
% "%% Bk" and every rule in a section gets the id core/Bk/n, so each Bk can be switched off.
% Inheritable relations are reified: pos(X, R, Y) / neg(X, R, Y); ternary: pos3 / neg3.

%% B1 is_a is transitive
isa(X, K) :- is_a(X, K).
isa(X, K) :- is_a(X, M), isa(M, K).

%% B2 default inheritance with specificity (most specific wins; diamonds block)
inh(X, P, Y, K)  :- isa(X, K), pos(K, P, Y), inheritable(P).
inhn(X, P, Y, K) :- isa(X, K), neg(K, P, Y), inheritable(P).
pre(X, P, Y, K)  :- inh(X, P, Y, K), neg(X, P, Y).
pre(X, P, Y, K)  :- inh(X, P, Y, K), inhn(X, P, Y, K2), isa(K2, K).
pren(X, P, Y, K) :- inhn(X, P, Y, K), pos(X, P, Y).
pren(X, P, Y, K) :- inhn(X, P, Y, K), inh(X, P, Y, K2), isa(K2, K).
live(X, P, Y, K)  :- inh(X, P, Y, K), not pre(X, P, Y, K).
liven(X, P, Y, K) :- inhn(X, P, Y, K), not pren(X, P, Y, K).
conflict(X, P, Y) :- live(X, P, Y, K1), liven(X, P, Y, K2).
holds(X, P, Y)  :- pos(X, P, Y).
holds(X, P, Y)  :- live(X, P, Y, K), not conflict(X, P, Y), not neg(X, P, Y).
holdsn(X, P, Y) :- neg(X, P, Y).
holdsn(X, P, Y) :- liven(X, P, Y, K), not conflict(X, P, Y), not pos(X, P, Y).
inh3(X, P, Y, Z, K)  :- isa(X, K), pos3(K, P, Y, Z).
inhn3(X, P, Y, Z, K) :- isa(X, K), neg3(K, P, Y, Z).
pre3(X, P, Y, Z, K)  :- inh3(X, P, Y, Z, K), neg3(X, P, Y, Z).
pre3(X, P, Y, Z, K)  :- inh3(X, P, Y, Z, K), inhn3(X, P, Y, Z, K2), isa(K2, K).
pren3(X, P, Y, Z, K) :- inhn3(X, P, Y, Z, K), pos3(X, P, Y, Z).
pren3(X, P, Y, Z, K) :- inhn3(X, P, Y, Z, K), inh3(X, P, Y, Z, K2), isa(K2, K).
live3(X, P, Y, Z, K)  :- inh3(X, P, Y, Z, K), not pre3(X, P, Y, Z, K).
liven3(X, P, Y, Z, K) :- inhn3(X, P, Y, Z, K), not pren3(X, P, Y, Z, K).
conflict3(X, P, Y, Z) :- live3(X, P, Y, Z, K1), liven3(X, P, Y, Z, K2).
holds3(X, P, Y, Z)  :- pos3(X, P, Y, Z).
holds3(X, P, Y, Z)  :- live3(X, P, Y, Z, K), not conflict3(X, P, Y, Z), not neg3(X, P, Y, Z).
holdsn3(X, P, Y, Z) :- neg3(X, P, Y, Z).
holdsn3(X, P, Y, Z) :- liven3(X, P, Y, Z, K), not conflict3(X, P, Y, Z), not pos3(X, P, Y, Z).
holds_effect(A, O, Z) :- effect(A, O, Z).
holds_effect(A, O, Z) :- effect(A, K, Z), isa(O, K).
holds_pre(A, O, Z) :- precondition(A, O, Z).
holds_pre(A, O, Z) :- precondition(A, K, Z), isa(O, K).

%% B3 contradiction raises a question
contradiction(X, P, Y) :- pos(X, P, Y), neg(X, P, Y).
contradiction3(X, P, Y, Z) :- pos3(X, P, Y, Z), neg3(X, P, Y, Z).
ask_conflict(X, P, Y) :- conflict(X, P, Y).
ask_conflict(X, P, Y) :- contradiction(X, P, Y).

%% B5 has_part is transitive
part(X, P) :- holds(X, has_part, P).
part(X, P) :- holds(X, has_part, M), part(M, P).

%% B6 bridges: roles and designed functions imply abilities (a taught negative beats them)
can(I, F) :- role(S, I, F), not holdsn(I, can_do, F), not conflict(I, can_do, F).
can(X, F) :- holds(X, used_for, F), not holdsn(X, can_do, F).
can(X, F) :- holds3(X, can_do_on, F, O), not holdsn(X, can_do, F).

%% B7 stand-in by function, with the demands check and an honest question
can(X, F) :- holds(X, can_do, F).
cand(S, I, J, F)  :- lacks(user, I), role(S, I, F), has(user, J), can(J, F), J != I.
unfit_known(S, J) :- cand(S, I, J, F), demands(S, F, P, Y), holdsn(J, P, Y).
fit_open(S, J)    :- cand(S, I, J, F), demands(S, F, P, Y), not holds(J, P, Y), not holdsn(J, P, Y).
stand_in(S, I, J) :- cand(S, I, J, F), not unfit_known(S, J), not fit_open(S, J).
ask_fit(S, J)     :- cand(S, I, J, F), not unfit_known(S, J), fit_open(S, J).
some_stand_in(S, I) :- stand_in(S, I, J).

%% B8 step replacement by effect
needed_state(S1, Z) :- before(S1, S2), requires_state(S2, Z), achieves(S1, Z).
blocked(S1)         :- uses(S1, I), lacks(user, I), not some_stand_in(S1, I).
lacks_for(A, O)     :- holds_pre(A, O, Z), not state_of(O, Z).
replace_step(S1, A2) :- blocked(S1), needed_state(S1, Z), object_of(S1, O), holds_effect(A2, O, Z), not lacks_for(A2, O).
replaced(S1) :- replace_step(S1, A2).

%% B9 gap: a lacked item with no stand-in and no replacement
gap(S, I) :- uses(S, I), lacks(user, I), not some_stand_in(S, I), not replaced(S).
